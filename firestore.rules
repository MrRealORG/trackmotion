rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }
    match /previews/{previewId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
